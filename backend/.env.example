# Copy to backend/.env. `make backend` (godotenv, cwd backend/) and
# `make up` (docker compose env_file) both read it. Every variable the
# backend reads is listed here; all but GITHUB_CLIENT_ID are optional.

# Listen port (default 8080). docker compose always sets 8080.
PORT=8080
# Where the SQLite database and bundle blobs live (default ./data, i.e.
# backend/data for `make backend`). docker compose always sets /data.
DATA_DIR=./data

# GitHub OAuth app client ID, with Device Flow enabled. Only the client ID is
# needed (no secret). If unset, /v1/auth/* returns 503 and nobody can log in.
GITHUB_CLIENT_ID=
# Overrides for tests or GitHub Enterprise; empty means the github.com defaults.
# REST API base (default https://api.github.com)
GITHUB_API_URL=
# OAuth/device-flow base (default https://github.com)
GITHUB_OAUTH_URL=

# Max accepted bundle upload in bytes (default 5 MiB); larger PUTs get 413
MAX_BUNDLE_BYTES=5242880
# Storage quotas. All four are whole numbers; 0 disables that limit; a negative
# or non-numeric value makes the server refuse to start. Bytes count stored
# tarballs, a digest shared by several of an owner's versions counts once, and
# removed versions stop counting. A publish over a per-user or per-bundle limit
# gets 413; over MAX_TOTAL_BYTES it gets 507 and a WARN line is logged. Users
# already over a limit can still download; they just cannot publish more.
# Per-user overrides: `capm admin quota <login> --bytes N --bundles N`.
# Stored bytes per owner (default 104857600 = 100 MiB)
MAX_USER_BYTES=104857600
# Bundle names per owner (default 50)
MAX_USER_BUNDLES=50
# Versions per bundle, yanked and removed included (default 200)
MAX_BUNDLE_VERSIONS=200
# Stored bytes across the whole registry (default 3221225472 = 3 GiB); keep it
# below the volume size so the disk never fills
MAX_TOTAL_BYTES=3221225472
# Publishes allowed per user per hour (default 30); more get 429
PUBLISH_RATE_PER_HOUR=30
# Requests per minute per client IP to /v1/auth/device and /v1/auth/token (default 30)
AUTH_RATE_PER_MINUTE=30
# Client IP comes from the socket address. Set true ONLY behind a reverse proxy
# that appends to X-Forwarded-For; otherwise clients could spoof it to evade limits.
TRUSTED_PROXY=false
# Name of one header holding the client IP (e.g. CF-Connecting-IP behind
# Cloudflare). Takes precedence over TRUSTED_PROXY; a missing or invalid value
# falls back to it. Set ONLY when every request reaches the backend through the
# proxy that sets this header, or clients can spoof it to evade limits.
CLIENT_IP_HEADER=

# Lifetime in days of newly issued API tokens (default 90). 0 means tokens never
# expire. Negative or non-numeric values make the server refuse to start. Tokens
# issued before this was introduced expire 90 days after the deploy that
# migrated the database, regardless of this setting.
TOKEN_TTL_DAYS=90

# Comma-separated GitHub NUMERIC user ids (not logins; logins can be reassigned)
# allowed to use /v1/admin/* (takedowns, bans, audit log) via `capm admin`.
# Whitespace is ignored. Empty or unset means no admins and the admin API
# answers 404 to everyone. A non-numeric entry makes the server refuse to start.
# Find an id with: curl https://api.github.com/users/<login> (the "id" field).
ADMIN_GITHUB_IDS=

# Abuse reports (POST /v1/bundles/{owner}/{name}/report; read with
# `capm admin reports`). Reports per client IP per hour (default 5); more get
# 429. 0 switches reporting off entirely (the route answers 404). Invalid
# values make the server refuse to start. The client IP comes from the same
# TRUSTED_PROXY / CLIENT_IP_HEADER logic as the auth limiter.
REPORT_RATE_PER_HOUR=5
# Optional. If set (http:// or https:// only; anything else refuses to start),
# every newly stored report triggers one POST of JSON {"text", "bundle",
# "version", "reason", "reportId", "details", "url"} to it: asynchronous, 5s
# timeout, no retries, never affects the reporter. It is operator-supplied and
# usually holds a secret, so treat it like a credential; only its host is ever
# logged. Unset = reports are stored and visible via the admin CLI only.
REPORT_WEBHOOK_URL=
# Optional public base URL of the website (e.g. https://capm.example.com), used
# only to put a link to the bundle page in the webhook message. Empty = no link.
PUBLIC_URL=

# Publish from CI: POST /v1/auth/oidc trades a GitHub Actions OIDC token for a
# 15 minute, publish-only registry token. On by default with GitHub's settings.
# These are commented out ON PURPOSE: an uncommented `OIDC_ISSUER=` (set but
# empty) DISABLES the endpoint, and docker compose's env_file would set it.
# Invalid values make the server refuse to start.
# The token issuer; tokens must carry exactly this `iss`. Default
# https://token.actions.githubusercontent.com. Set to an EMPTY value to disable
# the endpoint (it then answers 404). https only (http only for localhost).
# OIDC_ISSUER=https://token.actions.githubusercontent.com
# Where the issuer's signing keys (JWKS) are fetched. Default
# <issuer>/.well-known/jwks. Override for GitHub Enterprise or tests; never
# taken from a token.
# OIDC_JWKS_URL=https://token.actions.githubusercontent.com/.well-known/jwks
# The audience a workflow must request (the CLI and the Action use the registry
# URL). Default https://capm.masondrake.dev; set your own registry URL when
# self-hosting. Exactly one non-empty string; an empty value refuses to start.
# OIDC_AUDIENCE=https://capm.masondrake.dev
