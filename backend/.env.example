PORT=8080
# GitHub OAuth app client ID (device flow enabled); auth routes return 503 if unset
GITHUB_CLIENT_ID=
# Max accepted bundle upload in bytes (default 5 MiB); larger PUTs get 413
MAX_BUNDLE_BYTES=5242880
# Publishes allowed per user per hour (default 30); more get 429
PUBLISH_RATE_PER_HOUR=30
# Requests per minute per client IP to /v1/auth/device and /v1/auth/token (default 30)
AUTH_RATE_PER_MINUTE=30
# Client IP comes from the socket address. Set true ONLY behind a reverse proxy
# that appends to X-Forwarded-For; otherwise clients could spoof it to evade limits.
TRUSTED_PROXY=false
