#compdef capm
# zsh completion for capm. Generated by "capm completion zsh"; do not edit.
#
#   source <(capm completion zsh)             # after compinit; this shell only
#   capm completion zsh > "${fpath[1]}/_capm"  # or put it on your fpath
#
# Bundle references come from "capm __complete bundles", which asks the
# registry for at most one second and never fails.

_capm_bundles() {
  local -a refs
  refs=(${(f)"$("${words[1]}" __complete bundles "$PREFIX" 2>/dev/null)"})
  if (( ${#refs} )); then compadd -- $refs; fi
}

_capm() {
  local cur="${words[CURRENT]}" prev="${words[CURRENT-1]}" flag=""
  local -a vals
  # --flag=value arrives as one word: complete the value after the "=".
  if [[ $cur == -*=* ]]; then
    flag="${cur%%=*}"
    compset -P '*='
  elif [[ $prev == -* ]]; then
    flag="$prev"
  fi

  if (( CURRENT == 2 )); then
    local -a cmds
    cmds=(
      'login:Authenticate with a registry'
      'whoami:Print the login you are authenticated as'
      'orgs:List the organisations you may publish under'
      'logout:Revoke this machine'\''s token and delete the stored credentials'
      'tokens:List your login tokens; revoke one by id'
      'usage:Show your storage use and the registry'\''s limits'
      'init:Create a commented capm.yaml in a bundle directory'
      'lint:Check a bundle directory for problems before publishing'
      'push:Package and publish an agent to a registry'
      'pull:Download a bundle and check its digest'
      'inspect:Show a bundle'\''s declared permissions'
      'run:Launch an agent in a Docker Sandbox (sbx)'
      'search:Find bundles whose owner, name or description contains the text'
      'list:List bundles in the registry, or only one owner'\''s'
      'report:Report a bundle to the registry operator'
      'known:List the bundles capm remembers; forget one'
      'self-update:Replace this binary with the latest release'
      'outdated:List bundles you have run that have a newer version'
      'completion:Print a shell completion script (bash, zsh or fish)'
      'version:Print the capm version'
    )
    _describe 'command' cmds
    return 0
  fi
  case ${words[2]} in
    login)
      case $flag in
        --audience|-audience) return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--orgs --oidc --audience); compadd -- $vals; return 0; fi
      # no positional argument is completed
      return 0
      ;;
    whoami)
      # no positional argument is completed
      return 0
      ;;
    orgs)
      # no positional argument is completed
      return 0
      ;;
    logout)
      # no positional argument is completed
      return 0
      ;;
    tokens)
      if (( CURRENT == 3 )); then
        local -a subs
        subs=(
          'revoke:Revoke a login token'
        )
        _describe 'command' subs
        return 0
      fi
      case ${words[3]} in
        revoke)
          # no positional argument is completed
          return 0
          ;;
      esac
      return 0
      ;;
    usage)
      case $flag in
        --owner|-owner) return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--owner); compadd -- $vals; return 0; fi
      # no positional argument is completed
      return 0
      ;;
    init)
      case $flag in
        --name|-name) return 0 ;;
        --description|-description) return 0 ;;
        --author|-author) return 0 ;;
        --base|-base) vals=(claude-code opencode); compadd -- $vals; return 0 ;;
        --base-version|-base-version) return 0 ;;
        --egress|-egress) return 0 ;;
        --mount|-mount) _files; return 0 ;;
        --secret|-secret) return 0 ;;
        --repository|-repository) return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--yes --name --description --author --base --base-version --egress --mount --secret --repository); compadd -- $vals; return 0; fi
      _files -/
      return 0
      ;;
    lint)
      case $flag in
        --owner|-owner) return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--strict --offline --owner); compadd -- $vals; return 0; fi
      _files -/
      return 0
      ;;
    push)
      case $flag in
        --owner|-owner) return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--allow-secret-files --owner); compadd -- $vals; return 0; fi
      _files -/
      return 0
      ;;
    pull)
      if [[ $PREFIX == -* ]]; then vals=(--accept-new-owner --accept-new-signer --allow-invalid-signature); compadd -- $vals; return 0; fi
      _capm_bundles
      return 0
      ;;
    inspect)
      if [[ $PREFIX == -* ]]; then vals=(--diff); compadd -- $vals; return 0; fi
      case $PREFIX in ./*|../*|/*|\~*|.|..) _files -/; return 0 ;; esac
      _capm_bundles
      _files -/
      return 0
      ;;
    run)
      case $flag in
        --workdir|-workdir) _files -/; return 0 ;;
        --model-url|-model-url) return 0 ;;
        --model-key|-model-key) return 0 ;;
        --model|-model) return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--yes --allow-unenforced-egress --allow-global-anthropic-secret --accept-new-owner --accept-new-signer --allow-invalid-signature --accept-permission-changes --accept-changed-digest --workdir --model-url --model-key --model); compadd -- $vals; return 0; fi
      case $PREFIX in ./*|../*|/*|\~*|.|..) _files -/; return 0 ;; esac
      _capm_bundles
      _files -/
      return 0
      ;;
    search)
      case $flag in
        --sort|-sort) vals=(name recent downloads); compadd -- $vals; return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--sort); compadd -- $vals; return 0; fi
      # no positional argument is completed
      return 0
      ;;
    list)
      case $flag in
        --sort|-sort) vals=(name recent downloads); compadd -- $vals; return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--sort); compadd -- $vals; return 0; fi
      # no positional argument is completed
      return 0
      ;;
    report)
      case $flag in
        --reason|-reason) vals=(malware secrets-exposed impersonation other); compadd -- $vals; return 0 ;;
        --details|-details) return 0 ;;
      esac
      if [[ $PREFIX == -* ]]; then vals=(--reason --details); compadd -- $vals; return 0; fi
      _capm_bundles
      return 0
      ;;
    known)
      if (( CURRENT == 3 )); then
        local -a subs
        subs=(
          'forget:Forget a remembered bundle'
        )
        _describe 'command' subs
        return 0
      fi
      case ${words[3]} in
        forget)
          _capm_bundles
          return 0
          ;;
      esac
      return 0
      ;;
    self-update)
      if [[ $PREFIX == -* ]]; then vals=(--check); compadd -- $vals; return 0; fi
      # no positional argument is completed
      return 0
      ;;
    outdated)
      # no positional argument is completed
      return 0
      ;;
    completion)
      if (( CURRENT == 3 )); then vals=(bash zsh fish); compadd -- $vals; fi
      return 0
      ;;
    version)
      # no positional argument is completed
      return 0
      ;;
    admin)
      if (( CURRENT == 3 )); then
        local -a subs
        subs=(
          'remove:Take down a version or a whole bundle'
          'restore:Undo a removal'
          'ban:Block a user and hide their bundles'
          'unban:Lift a ban'
          'revoke-tokens:Revoke every login token of a user'
          'quota:Show or set a user'\''s storage limits'
          'log:Show the audit log of admin actions'
          'reports:List abuse reports'
          'report:Show one report in full'
          'resolve:Mark a report handled'
        )
        _describe 'command' subs
        return 0
      fi
      case ${words[3]} in
        remove)
          case $flag in
            --reason|-reason) return 0 ;;
          esac
          if [[ $PREFIX == -* ]]; then vals=(--reason); compadd -- $vals; return 0; fi
          _capm_bundles
          return 0
          ;;
        restore)
          _capm_bundles
          return 0
          ;;
        ban)
          case $flag in
            --reason|-reason) return 0 ;;
          esac
          if [[ $PREFIX == -* ]]; then vals=(--reason); compadd -- $vals; return 0; fi
          # no positional argument is completed
          return 0
          ;;
        unban)
          # no positional argument is completed
          return 0
          ;;
        revoke-tokens)
          # no positional argument is completed
          return 0
          ;;
        quota)
          case $flag in
            --bytes|-bytes) return 0 ;;
            --bundles|-bundles) return 0 ;;
          esac
          if [[ $PREFIX == -* ]]; then vals=(--bytes --bundles --reset); compadd -- $vals; return 0; fi
          # no positional argument is completed
          return 0
          ;;
        log)
          # no positional argument is completed
          return 0
          ;;
        reports)
          if [[ $PREFIX == -* ]]; then vals=(--all --resolved); compadd -- $vals; return 0; fi
          # no positional argument is completed
          return 0
          ;;
        report)
          # no positional argument is completed
          return 0
          ;;
        resolve)
          case $flag in
            --note|-note) return 0 ;;
          esac
          if [[ $PREFIX == -* ]]; then vals=(--note); compadd -- $vals; return 0; fi
          # no positional argument is completed
          return 0
          ;;
      esac
      return 0
      ;;
  esac
  return 0
}

if [ "$funcstack[1]" = "_capm" ]; then
  _capm "$@"
else
  compdef _capm capm
fi
